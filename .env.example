# ---------------------------------------------------------------
# Dante AI — choose ONE provider
# ---------------------------------------------------------------

# Option A: PSNC / PCSS or any OpenAI-compatible API (vLLM, Ollama, LM Studio, OpenRouter…)
# LLM_BASE_URL is the part before /chat/completions, usually ending in /v1
LLM_PROVIDER="openai"
LLM_BASE_URL="https://your-psnc-endpoint.example/v1"
LLM_API_KEY="your_psnc_api_key"
LLM_MODEL="model-name-from-psnc"
# Vision extraction for Snap a syllabus; uses the same LLM_BASE_URL/LLM_API_KEY.
VISION_MODEL="Qwen3-VL-235B-A22B-Instruct-FP8"
# Optional tuning
# LLM_TEMPERATURE=0.6
# LLM_MAX_TOKENS=1200
# LLM_TIMEOUT_MS=60000
# Extra headers if your provider needs them, as JSON:
# LLM_EXTRA_HEADERS='{"X-Project-Id":"abc"}'

# Option B: Google Gemini (used when LLM_PROVIDER="gemini" or no LLM_BASE_URL is set)
# GEMINI_API_KEY="your_gemini_key"
# GEMINI_MODEL="gemini-2.5-flash"

# Requests per user per minute shared by chat and transcription
DANTE_RATE_LIMIT=20
# Allow the AI without login (local/demo mode). Keep false on a public server.
DANTE_ALLOW_ANONYMOUS=false

# ---------------------------------------------------------------
# Supabase (auth + database)
# ---------------------------------------------------------------
# Used by the browser in `npm run dev`
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key"
# Used by the server to verify logins, and injected into the page in production
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key"

PORT=3000

# ---------------------------------------------------------------
# Optional Sentry error monitoring — leave blank to disable
# ---------------------------------------------------------------
# Server only. Not exposed to the browser; read at server startup.
SENTRY_DSN=""
# Public browser ingest DSN, baked into the Vite build (restart dev/rebuild to change).
# Never put an auth token, service-role key or private Sentry API token here.
VITE_SENTRY_DSN=""
# Errors only: no request bodies, messages, breadcrumbs, user details, replay,
# tracing, or application content. Error messages/source context are redacted.

# Daily Dante quotas (independent of the per-minute DANTE_RATE_LIMIT).
# Positive integer; default 20 chat calls AND 20 transcription calls per user/day.
# Days reset at 00:00 UTC. Authenticated attempts count even if the AI call fails.
DANTE_DAILY_LIMIT=20
# SERVER ONLY: optional Supabase service-role key for atomic quota counting.
# Missing/blank skips daily limits. Never use a VITE_ prefix or expose this key.
# Apply supabase-schema-update.sql before enabling; SUPABASE_URL is also required.
SUPABASE_SERVICE_ROLE_KEY=""

# Optional Stripe subscriptions (server-only; leave blank to disable).
# Also requires SUPABASE_SERVICE_ROLE_KEY and Supabase auth. See docs/BILLING.md.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Trusted redirect origin; defaults to https://zenose.tech
BILLING_APP_URL=

# Persistent Google Calendar access (SERVER ONLY; use the same OAuth client as Supabase).
# Requires SUPABASE_SERVICE_ROLE_KEY; apply the SQL migration, then reconnect Calendar.
# Never use VITE_ prefixes for Google OAuth secrets. See docs/GOOGLE_CALENDAR.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Semantic search (SERVER ONLY). Uses LLM_BASE_URL /embeddings and LLM_API_KEY.
# Qwen3-Embedding-0.6B outputs 1024 dimensions. Other models must also return 1024.
# Apply the latest SQL migration with pgvector enabled. See docs/SEARCH.md.
EMBEDDING_MODEL=Qwen3-Embedding-0.6B
# Default true: process pending note changes every 15 seconds under per-user quotas.
# Run one background indexer per database; set false on additional replicas.
SEARCH_INDEX_WORKER=true

# My Space AI editor: comma-separated allowlist of 1–3 model IDs from the active
# chat provider. Defaults to LLM_MODEL (or GEMINI_MODEL for Gemini).
# Only these IDs can be selected; never put credentials or URLs here.
# SPACE_MODELS=Qwen3.8-27B

# Model Arena: 2–3 distinct models at the same configured provider.
# Defaults to SPACE_MODELS; a single configured model disables Arena only.
# ARENA_MODELS=Qwen3.8-27B,another-model-supported-by-your-provider

# Public My Space gallery moderation: canonical, confirmed Supabase email addresses.
# Server-only; restart after changes. Never use VITE_ADMIN_EMAILS.
# ADMIN_EMAILS=admin@example.com,another-admin@example.com

# Weekly recap scheduling (SERVER ONLY, default true). Uses existing Supabase
# service credentials; no LLM calls/quota. Multiple replicas coordinate in SQL.
# Always-running deployment required for Sunday 18:00 generation while away;
# Home also catches up missed schedules. See docs/WEEKLY_RECAPS.md.
WEEKLY_RECAP_WORKER=true

# Optional Dante Live text-to-speech (SERVER ONLY). All four are required.
# Provider must implement /audio/speech with MP3 output; Whisper is STT, not TTS.
# Uses a separate DANTE_DAILY_LIMIT allowance (default 20 paid sections/day).
# Apply the latest SQL migration and keep SUPABASE_SERVICE_ROLE_KEY configured.
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=
